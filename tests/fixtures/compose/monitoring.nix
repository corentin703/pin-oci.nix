# Review it, then run `pin-oci lock` to pin the images.
{
  virtualisation.pin-oci.projects."monitoring" = {
    enable = true;
    networks.default.enable = true;
    volumes."grafana_data" = { };
    volumes."prom_data" = { };
    services."grafana" = {
      image = "redis:7";
      ports = [
        "3000:3000"
      ];
      volumes = [
        "grafana_data:/var/lib/grafana"
