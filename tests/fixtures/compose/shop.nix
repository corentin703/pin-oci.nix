# Generated by `pin-oci convert` from shop.yml.
# Review it, then run `pin-oci lock` to pin the images.
{
  virtualisation.pin-oci.projects."shop" = {
    enable = true;
    networks."back" = {
      internal = true;
      subnet = "10.30.0.0/24";
    };
    networks."front" = { };
    volumes."shared" = {
      external = true;
    };
    volumes."site" = { };
    services."cache" = {
      image = "redis:7";
      networks = [
        "back"
      ];
    };
    services."web" = {
      image = "caddy:2-alpine";
      entrypoint = "/usr/bin/caddy";
      cmd = [
        "run"
        "caddy"
        "file-server"
        "--root"
        "/srv/site docs"
      ];
      environment = {
        "DEBUG" = "no";
        "GREETING" = "hello world";
        "MODE" = "prod";
      };
      labels = {
        "team" = "platform";
      };
      ports = [
        "80:80"
        "127.0.0.1:8443:443"
      ];
      volumes = [
        "site:/srv"
        "/etc/caddy:/etc/caddy:ro"
        "shared:/shared"
      ];
      dependsOn = [
        "cache"
      ];
      networks = [
        "front"
        "back"
      ];
      user = "1000:1000";
      workdir = "/srv";
    };
  };
}
